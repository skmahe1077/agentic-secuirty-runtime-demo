# Copy to terraform.tfvars and fill in. Never commit the real file --
# it's already in .gitignore.

aws_region = "eu-west-1"
name       = "agentic-sec-demo"

# Create this out of band BEFORE the first apply:
#   aws secretsmanager create-secret --name agentic-sec-demo/vault-license \
#     --secret-string "$(cat vault.hclic)"
vault_license_secret_name = "agentic-sec-demo/vault-license"

# The storefront ALB is public and /api/admin/reset + /api/admin/revoke are
# unauthenticated -- narrow this to your current IP right before the talk.
# alb_inbound_cidrs = ["203.0.113.4/32"]
