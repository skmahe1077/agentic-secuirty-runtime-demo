# Copy to terraform.tfvars and fill in. Never commit the real file --
# it's already in .gitignore.

aws_region  = "eu-west-1"
hvn_region  = "eu-west-1"
name        = "agentic-sec-demo"

# Tighten this to your current IP (`curl -s ifconfig.me`) right before a
# rehearsal -- see variables.tf's note on why public_endpoint is on at all.
vault_ip_allowlist = []

# Leave false until scripts/03-verify.sh's probe has actually confirmed
# auth/spiffe on your cluster -- see hcp.tf and vault-config.tf.
spiffe_auth_available = false
